<link rel="stylesheet" href="{{ module_asset('CommerceAgents', 'assets/css/chat-widget.css') }}?v={{ assetVersion }}">
<script src="{{ module_asset('CommerceAgents', 'assets/js/chat-markdown.js') }}?v={{ assetVersion }}"></script>
<script src="{{ module_asset('CommerceAgents', 'assets/js/chat-widget.js') }}?v={{ assetVersion }}"></script>
<script src="{{ module_asset('CommerceAgents', 'assets/js/alpine.min.js') }}" defer></script>

<div id="commerce-agents-widget"
     x-data="commerceAgentsChat()"
     data-config="{{ { cart: cart, account: account, locale: locale, i18n: i18n, checkoutUrl: checkoutUrl }|json_encode|e('html_attr') }}"
     x-cloak>

    {# ---------- Proactive bubble: floating, shown only when the widget is closed/collapsed ---------- #}
    <div class="caw-proactive" x-show="proactive && !isOpen" x-cloak
         x-bind:class="isCartPage ? 'caw-proactive--cart' : ''"
         x-on:keydown.escape.window="proactive && !isOpen && dismissProactive()"
         x-transition:enter="caw-proactive-enter"
         x-transition:enter-start="caw-proactive-enter-start"
         x-transition:enter-end="caw-proactive-enter-end"
         x-transition:leave="caw-proactive-leave"
         x-transition:leave-start="caw-proactive-leave-start"
         x-transition:leave-end="caw-proactive-leave-end">
        <section class="caw-proactive-card" role="status" aria-live="polite" aria-label="{{ i18n.proactiveLabel }}">
            <header class="caw-proactive-head">
                <span class="caw-proactive-badge">
                    <span class="caw-proactive-badge-icon" aria-hidden="true">✨</span>
                    <span x-text="i18n.suggestionBadge"></span>
                </span>
                <button type="button" class="caw-icon-button" x-on:click="dismissProactive()"
                        title="{{ i18n.dismissSuggestion }}" aria-label="{{ i18n.dismissSuggestion }}">✕</button>
            </header>

            <p class="caw-proactive-text" x-show="proactive" x-text="proactive?.text"></p>

            {# Carte coupon (scénarios 6/7, spec MYO-245 composant 3) : un code
               à copier directement et/ou une progression vers un palier de
               remise, selon ce que ProactiveMessage a rempli côté serveur. #}
            <template x-if="proactive?.card?.type === 'coupon'">
                <div class="caw-coupon">
                    <p class="caw-coupon-code" x-show="proactive.card.data.code">
                        <span class="caw-coupon-chip"><code x-text="proactive.card.data.code"></code></span>
                    </p>
                    <p class="caw-coupon-condition" x-show="proactive.card.data.conditionLabel" x-text="proactive.card.data.conditionLabel"></p>

                    <div class="caw-coupon-progress" x-show="proactive.card.data.tiers">
                        <p class="caw-coupon-progress-label" x-show="proactive.card.data.progressLabel" x-text="proactive.card.data.progressLabel"></p>
                        <div class="caw-coupon-bar" role="progressbar"
                             x-bind:aria-valuenow="proactive.card.data.progressPercent"
                             aria-valuemin="0" aria-valuemax="100"
                             x-bind:aria-label="proactive.card.data.progressAria">
                            <div class="caw-coupon-bar-fill" x-bind:style="'width:' + (proactive.card.data.progressPercent || 0) + '%'"></div>
                            <template x-for="tier in (proactive.card.data.tiers || [])" x-bind:key="tier.label">
                                <span class="caw-coupon-tier" aria-hidden="true" x-bind:title="tier.label"
                                      x-bind:class="tier.reached && 'is-reached'" x-bind:style="'left:' + tier.position + '%'"></span>
                            </template>
                        </div>
                    </div>

                    <button type="button" class="caw-btn caw-btn-primary caw-btn-block" x-show="proactive.card.data.code"
                            x-bind:disabled="proactive.card.data.applying || proactive.card.data.applied"
                            x-on:click="applyCoupon(proactive.card.data)"
                            x-text="proactive.card.data.applied ? (i18n.couponAppliedPrefix + ' ' + money(proactive.card.data.appliedDiscount)) : (proactive.card.data.applying ? i18n.couponApplying : i18n.applyCoupon)"></button>

                    <p class="caw-coupon-error" x-show="proactive.card.data.error" x-text="proactive.card.data.error" role="alert"></p>
                </div>
            </template>

            {# Carte opt-in newsletter (MYO-471/MYO-475 backend, T7 spec MYO-476) :
               e-mail + case de consentement non pré-cochée. Aucun code promo
               dans ce payload — newsletterOptinCard() ne renvoie jamais que
               conditionLabel, le code (s'il y en a un) part par e-mail côté
               backend, jamais dans cette réponse JSON. #}
            <template x-if="proactive?.card?.type === 'newsletter_optin'">
                <form class="caw-newsletter" x-on:submit.prevent="subscribeNewsletter(proactive.card.data)">
                    <p class="caw-coupon-condition" x-show="proactive.card.data.conditionLabel" x-text="proactive.card.data.conditionLabel"></p>

                    <template x-if="!proactive.card.data.subscribed">
                        <div class="caw-newsletter-form">
                            <input type="email" class="caw-newsletter-input"
                                   x-model="proactive.card.data.email"
                                   x-bind:disabled="proactive.card.data.submitting"
                                   autocomplete="email"
                                   aria-label="{{ i18n.newsletterOptinEmailPlaceholder }}"
                                   placeholder="{{ i18n.newsletterOptinEmailPlaceholder }}">

                            <label class="caw-newsletter-consent">
                                <input type="checkbox"
                                       x-model="proactive.card.data.consent"
                                       x-bind:disabled="proactive.card.data.submitting">
                                <span>
                                    {{ i18n.newsletterOptinConsentLabel }}
                                    {% if privacyPolicyUrl %}
                                        <a href="{{ privacyPolicyUrl }}" target="_blank" rel="noopener">{{ i18n.newsletterOptinPrivacyLink }}</a>
                                    {% endif %}
                                </span>
                            </label>

                            <button type="submit" class="caw-btn caw-btn-primary caw-btn-block"
                                    x-bind:disabled="proactive.card.data.submitting || !proactive.card.data.email || !proactive.card.data.consent"
                                    x-text="proactive.card.data.submitting ? i18n.newsletterOptinSubscribing : i18n.newsletterOptinSubscribe"></button>
                        </div>
                    </template>

                    <p class="caw-newsletter-success" x-show="proactive.card.data.subscribed" x-text="i18n.newsletterOptinSubscribed" role="status"></p>

                    <p class="caw-coupon-error" x-show="proactive.card.data.error" x-text="proactive.card.data.error" role="alert"></p>
                </form>
            </template>

            <div class="caw-proactive-actions">
                <button type="button" class="caw-btn caw-btn-primary" x-on:click="acceptProactive()" x-text="i18n.proactiveSeeMore"></button>
                <button type="button" class="caw-btn caw-btn-ghost" x-on:click="dismissProactive()" x-text="i18n.noThanks"></button>
            </div>
        </section>
    </div>

    {# ---------- Dock: slim bar anchored at the bottom, grows into the overlay ---------- #}
    <div class="caw-dock" x-show="!isOpen && !isCartPage" x-transition.opacity>
        <form class="caw-glow caw-glow-dock" x-on:submit.prevent="send()">
            <div class="caw-dock-inner">
                <span class="caw-avatar" aria-hidden="true">✦</span>
                <input type="text"
                       class="caw-dock-input"
                       x-model="input"
                       x-on:focus="focusDock()"
                       maxlength="2000"
                       autocomplete="off"
                       aria-label="{{ i18n.openAssistant }}"
                       placeholder="{{ i18n.askPlaceholder }}">
                <button type="button"
                        class="caw-dock-cart"
                        x-show="cart.itemCount > 0"
                        x-on:click="expand()"
                        x-bind:aria-label="cart.itemCount + ' ' + i18n.itemsLabel">
                    <span class="caw-dock-cart-icon" aria-hidden="true">🛒</span>
                    <span class="caw-dock-cart-count" x-text="cart.itemCount"></span>
                    <span class="caw-dock-cart-total" x-text="money(cart.totalTaxedAmount)"></span>
                </button>
                <button type="submit" class="caw-dock-send" aria-label="{{ i18n.send }}">➤</button>
            </div>
        </form>
    </div>

    {# ---------- Dock (bulle repliée, MYO-479/480/493) : uniquement sur /panier,
       en remplacement de la barre pleine largeur ci-dessus — même état `dock`
       de la machine à états, flag d'affichage orthogonal (spec §2). Pas de champ
       de saisie ni de puce panier (spec §3.3) : un simple bouton d'ouverture. #}
    <div class="caw-dock-cartpage" x-show="!isOpen && isCartPage"
         x-transition:enter="caw-dock-bubble-enter"
         x-transition:enter-start="caw-dock-bubble-enter-start"
         x-transition:enter-end="caw-dock-bubble-enter-end"
         x-transition:leave="caw-dock-bubble-leave"
         x-transition:leave-start="caw-dock-bubble-leave-start"
         x-transition:leave-end="caw-dock-bubble-leave-end">
        <button type="button" class="caw-dock-bubble" x-on:click="expand()"
                aria-haspopup="dialog"
                x-bind:aria-expanded="isOpen ? 'true' : 'false'"
                aria-label="{{ i18n.openAssistant }}">
            <span class="caw-avatar" aria-hidden="true">✦</span>
            <span class="caw-dock-ping" x-show="proactive" aria-hidden="true"></span>
            <span class="caw-dock-bubble-label" aria-hidden="true">{{ i18n.openAssistant }}</span>
        </button>
        <span class="caw-sr-only" aria-live="polite" x-show="proactive" x-text="i18n.newSuggestionAvailable"></span>
    </div>

    {# ---------- Collapsed: the running conversation, page still readable ---------- #}
    <div class="caw-collapsed" x-show="isCollapsed" x-transition.opacity
         x-bind:class="isCartPage ? 'caw-collapsed--cart' : ''">
        <section class="caw-collapsed-card" aria-label="{{ assistantName }}">
            <header class="caw-collapsed-head">
                <span class="caw-avatar" aria-hidden="true">✦</span>
                <strong>{{ assistantName }}</strong>
                <button type="button" class="caw-icon-button" x-on:click="expand()"
                        x-bind:title="i18n.expandAssistant" x-bind:aria-label="i18n.expandAssistant">⤢</button>
                <button type="button" class="caw-icon-button" x-on:click="minimise()"
                        x-bind:title="i18n.minimiseAssistant" x-bind:aria-label="i18n.minimiseAssistant">✕</button>
            </header>

            <p class="caw-typing caw-collapsed-typing" x-show="pending" aria-live="polite">
                <span></span><span></span><span></span>
            </p>

            <div class="caw-collapsed-reply" x-show="!pending && lastReply"
                 x-effect="window.CommerceAgentsMarkdown.render($el, lastReply)"></div>

            <div class="caw-collapsed-products" x-show="highlights.length > 0">
                <template x-for="product in highlights" x-bind:key="product.id">
                    <a class="caw-collapsed-product" x-bind:href="product.url" x-bind:title="product.title">
                        <span class="caw-cart-thumb">
                            <img x-show="product.imageUrl" x-bind:src="product.imageUrl" x-bind:alt="product.title" loading="lazy">
                        </span>
                        <span class="caw-collapsed-price" x-text="money(bestPrice(product), product.currency)"></span>
                    </a>
                </template>
            </div>

            <p class="caw-collapsed-cart" x-show="cart.itemCount > 0">
                <span x-text="cart.itemCount + ' ' + i18n.itemsLabel"></span>
                <strong x-text="money(cart.totalTaxedAmount, cart.currency)"></strong>
                <a class="caw-btn caw-btn-primary" href="{{ checkoutUrl }}">{{ i18n.completeOrder }}</a>
            </p>
        </section>
    </div>

    {# ---------- Overlay ---------- #}
    <div class="caw-backdrop" x-show="isOpen" x-transition.opacity x-on:click="close()"></div>

    <section class="caw-shell"
             x-show="isOpen"
             x-transition
             role="dialog"
             aria-modal="true"
             aria-label="{{ assistantName }}"
             x-on:keydown.escape.window="close()">
        <div class="caw-shell-frame">
            <div class="caw-shell-inner">

                <div class="caw-main" x-bind:class="messages.length === 0 && 'is-hero'">
                    <header class="caw-header">
                        <span class="caw-avatar" aria-hidden="true">✦</span>
                        <span class="caw-header-titles">
                            <strong>{{ assistantName }}</strong>
                            <small>{{ i18n.subtitle }}</small>
                        </span>
                        <button type="button" class="caw-icon-button" x-show="messages.length > 0"
                                x-on:click="reset()" title="{{ i18n.clearConversation }}"
                                aria-label="{{ i18n.clearConversation }}">↺</button>
                        <button type="button" class="caw-icon-button" x-on:click="close()"
                                title="{{ i18n.closeAssistant }}" aria-label="{{ i18n.closeAssistant }}">✕</button>
                    </header>

                    <div class="caw-spacer"></div>

                    <div class="caw-hero" x-show="messages.length === 0">
                        <p class="caw-hero-title">{{ i18n.helpTitle }}</p>
                        <div class="caw-chips">
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestProduct }}</button>
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestCart }}</button>
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestShipping }}</button>
                            {% if isCustomerLoggedIn %}
                                <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestOrders }}</button>
                            {% endif %}
                        </div>
                    </div>

                    <div class="caw-messages" x-ref="messages" x-show="messages.length > 0">
                        <template x-for="(message, index) in messages" x-bind:key="index">
                            <div class="caw-row">
                                {# x-if, not x-show: Alpine evaluates the expressions of a hidden
                                   subtree, and message.data only exists on the rich blocks. #}
                                <template x-if="message.kind === 'text' && message.role === 'user'">
                                    <p class="caw-message caw-user" x-text="message.text"></p>
                                </template>

                                <template x-if="message.kind === 'text' && message.role === 'assistant'">
                                    <div class="caw-reply">
                                        {# A named product always comes with its picture and its buttons. #}
                                        <div class="caw-variant-grid caw-recalled" x-show="cardsFor(message, index).length > 0">
                                            <template x-for="card in cardsFor(message, index)" x-bind:key="card.id">
                                                <article class="caw-variant">
                                                    <a class="caw-variant-media" x-bind:href="card.url || '#'">
                                                        <img x-show="card.imageUrl" x-bind:src="card.imageUrl"
                                                             x-bind:alt="card.productTitle" loading="lazy">
                                                    </a>
                                                    <div class="caw-variant-body">
                                                        <a class="caw-variant-title" x-bind:href="card.url || '#'" x-text="card.productTitle"></a>
                                                        <p class="caw-variant-label" x-show="card.label" x-text="card.label"></p>
                                                        <p class="caw-product-price">
                                                            <span class="caw-price-now" x-text="money(bestPrice(card), card.currency)"></span>
                                                            <s class="caw-price-was" x-show="hasPromo(card)" x-text="money(card.price, card.currency)"></s>
                                                        </p>
                                                        <div class="caw-product-actions">
                                                            <button type="button" class="caw-btn caw-btn-primary" x-show="card.inStock"
                                                                    x-on:click="addCardToCart(card)" x-text="i18n.addToCart"></button>
                                                            <a class="caw-btn caw-btn-ghost" x-bind:href="card.url || '#'" x-text="i18n.viewProduct"></a>
                                                        </div>
                                                    </div>
                                                </article>
                                            </template>
                                        </div>

                                        <div class="caw-message caw-assistant"
                                             x-effect="window.CommerceAgentsMarkdown.render($el, displayText(message, index))"></div>

                                        {# MYO-282/283: contextual quick replies, renewed on every assistant
                                           reply — only ever under the very last one, never a historical
                                           message. Real <a href> for navigation, <button> for a relance
                                           message, so "open in a new tab" keeps working natively (§4). #}
                                        <div class="caw-quickreplies"
                                             x-show="index === messages.length - 1 && (message.suggestions || []).length > 0"
                                             x-bind:class="message.suggestionsDefault ? 'caw-quickreplies--default' : ''"
                                             role="group"
                                             aria-label="{{ i18n.quickRepliesLabel }}">
                                            <template x-for="suggestion in (message.suggestions || [])" x-bind:key="suggestion.id">
                                                <span class="caw-quickreply-slot">
                                                    <a class="caw-quickreply caw-quickreply--nav" x-show="suggestion.action.type === 'navigate'"
                                                       x-bind:href="suggestion.action.url" x-text="suggestion.label"></a>
                                                    <button type="button" class="caw-quickreply caw-quickreply--message" x-show="suggestion.action.type === 'message'"
                                                            x-on:click="sendQuickReply(suggestion)" x-text="suggestion.label"></button>
                                                </span>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="message.kind === 'products'">
                                    <div class="caw-products">
                                        <p class="caw-products-caption" x-show="productsCaption(message)"
                                           x-text="productsCaption(message)"></p>

                                        <article class="caw-product caw-product-hero">
                                            <a class="caw-product-media" x-bind:href="message.data[0].url">
                                                <img x-show="message.data[0].imageUrl" x-bind:src="message.data[0].imageUrl" x-bind:alt="message.data[0].title" loading="lazy">
                                                <span class="caw-product-flag" x-text="i18n.featured"></span>
                                                <span class="caw-product-deal" x-show="hasPromo(message.data[0])"
                                                      x-text="'-' + discountPercent(message.data[0]) + '%'"></span>
                                            </a>
                                            <div class="caw-product-body">
                                                <a class="caw-product-title" x-bind:href="message.data[0].url" x-text="message.data[0].title"></a>
                                                <p class="caw-product-desc" x-show="message.data[0].description" x-text="message.data[0].description"></p>
                                                <p class="caw-product-price">
                                                    <span class="caw-price-now" x-text="money(bestPrice(message.data[0]), message.data[0].currency)"></span>
                                                    <s class="caw-price-was" x-show="hasPromo(message.data[0])" x-text="money(message.data[0].price, message.data[0].currency)"></s>
                                                    <span class="caw-stock" x-bind:class="message.data[0].inStock ? 'is-in' : 'is-out'"
                                                          x-text="message.data[0].inStock ? i18n.inStock : i18n.outOfStock"></span>
                                                </p>
                                                <div class="caw-product-actions">
                                                    <button type="button" class="caw-btn caw-btn-primary" x-show="message.data[0].inStock"
                                                            x-on:click="askAddToCart(message.data[0])" x-text="i18n.addToCart"></button>
                                                    <a class="caw-btn caw-btn-ghost" x-bind:href="message.data[0].url" x-text="i18n.viewProduct"></a>
                                                </div>
                                            </div>
                                        </article>

                                        <div class="caw-product-grid" x-show="message.data.length > 1">
                                            <template x-for="product in message.data.slice(1)" x-bind:key="product.id">
                                                <article class="caw-product">
                                                    <a class="caw-product-media" x-bind:href="product.url">
                                                        <img x-show="product.imageUrl" x-bind:src="product.imageUrl" x-bind:alt="product.title" loading="lazy">
                                                        <span class="caw-product-deal" x-show="hasPromo(product)"
                                                              x-text="'-' + discountPercent(product) + '%'"></span>
                                                    </a>
                                                    <div class="caw-product-body">
                                                        <a class="caw-product-title" x-bind:href="product.url" x-text="product.title"></a>
                                                        <p class="caw-product-price">
                                                            <span class="caw-price-now" x-text="money(bestPrice(product), product.currency)"></span>
                                                            <s class="caw-price-was" x-show="hasPromo(product)" x-text="money(product.price, product.currency)"></s>
                                                        </p>
                                                        <div class="caw-product-actions">
                                                            <button type="button" class="caw-btn caw-btn-primary" x-show="product.inStock"
                                                                    x-on:click="askAddToCart(product)" x-text="i18n.addToCart"></button>
                                                            <a class="caw-btn caw-btn-ghost" x-bind:href="product.url" x-text="i18n.viewProduct"></a>
                                                        </div>
                                                    </div>
                                                </article>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="message.kind === 'variants'">
                                    <div class="caw-variants">
                                        <p class="caw-variants-title" x-text="variantsHeading(message)"></p>

                                        <div class="caw-variant-grid">
                                            <template x-for="variant in message.data" x-bind:key="variant.id">
                                                <article class="caw-variant">
                                                    <a class="caw-variant-media" x-bind:href="variantUrl(message, variant)">
                                                        <img x-show="variant.imageUrl" x-bind:src="variant.imageUrl"
                                                             x-bind:alt="variant.productTitle || variant.label" loading="lazy">
                                                    </a>
                                                    <div class="caw-variant-body">
                                                        <a class="caw-variant-title" x-show="variant.productTitle"
                                                           x-bind:href="variantUrl(message, variant)" x-text="variant.productTitle"></a>
                                                        <p class="caw-variant-label" x-text="variant.label"></p>
                                                        <p class="caw-product-price">
                                                            <span class="caw-price-now" x-text="money(bestPrice(variant), variantCurrency(message, variant))"></span>
                                                            <s class="caw-price-was" x-show="hasPromo(variant)"
                                                               x-text="money(variant.price, variantCurrency(message, variant))"></s>
                                                        </p>
                                                        <p class="caw-stock" x-bind:class="variant.inStock ? 'is-in' : 'is-out'"
                                                           x-text="variant.inStock ? i18n.inStock : i18n.outOfStock"></p>
                                                        <button type="button" class="caw-btn caw-btn-primary caw-btn-block"
                                                                x-show="variant.inStock"
                                                                x-on:click="askAddVariantToCart(message.product, variant)"
                                                                x-text="i18n.addToCart"></button>
                                                    </div>
                                                </article>
                                            </template>
                                        </div>
                                    </div>
                                </template>

                                <template x-if="message.kind === 'cart'">
                                    <div class="caw-cart-block">
                                        <template x-for="item in (message.data.items || [])" x-bind:key="item.productId">
                                            <p class="caw-cart-line">
                                                <span class="caw-cart-thumb">
                                                    <img x-show="item.imageUrl" x-bind:src="item.imageUrl" x-bind:alt="item.title" loading="lazy">
                                                </span>
                                                <span class="caw-cart-name" x-text="item.title"></span>
                                                <span class="caw-cart-qty" x-text="'\u00d7' + item.quantity"></span>
                                                <span class="caw-cart-price" x-text="money(item.totalTaxedPrice, message.data.currency)"></span>
                                            </p>
                                        </template>
                                        <p class="caw-cart-total">
                                            <span>{{ i18n.total }}</span>
                                            <strong x-text="money(message.data.totalTaxedAmount, message.data.currency)"></strong>
                                        </p>
                                    </div>
                                </template>

                                <template x-if="message.kind === 'error'">
                                    <p class="caw-message caw-error">
                                        <span x-text="message.text"></span>
                                        <button type="button" class="caw-retry" x-on:click="retry()">↻</button>
                                    </p>
                                </template>

                                {# A proactive suggestion that arrived while the overlay was already
                                   open: same content as the floating card, inline in the thread. #}
                                <template x-if="message.kind === 'proactive'">
                                    <div class="caw-message-proactive" role="status" aria-label="{{ i18n.proactiveLabel }}">
                                        <header class="caw-proactive-head">
                                            <span class="caw-proactive-badge">
                                                <span class="caw-proactive-badge-icon" aria-hidden="true">✨</span>
                                                <span x-text="i18n.suggestionBadge"></span>
                                            </span>
                                        </header>
                                        <p class="caw-proactive-text" x-text="message.text"></p>

                                        <template x-if="message.card?.type === 'coupon'">
                                            <div class="caw-coupon">
                                                <p class="caw-coupon-code" x-show="message.card.data.code">
                                                    <span class="caw-coupon-chip"><code x-text="message.card.data.code"></code></span>
                                                </p>
                                                <p class="caw-coupon-condition" x-show="message.card.data.conditionLabel" x-text="message.card.data.conditionLabel"></p>

                                                <div class="caw-coupon-progress" x-show="message.card.data.tiers">
                                                    <p class="caw-coupon-progress-label" x-show="message.card.data.progressLabel" x-text="message.card.data.progressLabel"></p>
                                                    <div class="caw-coupon-bar" role="progressbar"
                                                         x-bind:aria-valuenow="message.card.data.progressPercent"
                                                         aria-valuemin="0" aria-valuemax="100"
                                                         x-bind:aria-label="message.card.data.progressAria">
                                                        <div class="caw-coupon-bar-fill" x-bind:style="'width:' + (message.card.data.progressPercent || 0) + '%'"></div>
                                                        <template x-for="tier in (message.card.data.tiers || [])" x-bind:key="tier.label">
                                                            <span class="caw-coupon-tier" aria-hidden="true" x-bind:title="tier.label"
                                                                  x-bind:class="tier.reached && 'is-reached'" x-bind:style="'left:' + tier.position + '%'"></span>
                                                        </template>
                                                    </div>
                                                </div>

                                                <button type="button" class="caw-btn caw-btn-primary caw-btn-block" x-show="message.card.data.code"
                                                        x-bind:disabled="message.card.data.applying || message.card.data.applied"
                                                        x-on:click="applyCoupon(message.card.data)"
                                                        x-text="message.card.data.applied ? (i18n.couponAppliedPrefix + ' ' + money(message.card.data.appliedDiscount)) : (message.card.data.applying ? i18n.couponApplying : i18n.applyCoupon)"></button>

                                                <p class="caw-coupon-error" x-show="message.card.data.error" x-text="message.card.data.error" role="alert"></p>
                                            </div>
                                        </template>

                                        <template x-if="message.card?.type === 'newsletter_optin'">
                                            <form class="caw-newsletter" x-on:submit.prevent="subscribeNewsletter(message.card.data)">
                                                <p class="caw-coupon-condition" x-show="message.card.data.conditionLabel" x-text="message.card.data.conditionLabel"></p>

                                                <template x-if="!message.card.data.subscribed">
                                                    <div class="caw-newsletter-form">
                                                        <input type="email" class="caw-newsletter-input"
                                                               x-model="message.card.data.email"
                                                               x-bind:disabled="message.card.data.submitting"
                                                               autocomplete="email"
                                                               aria-label="{{ i18n.newsletterOptinEmailPlaceholder }}"
                                                               placeholder="{{ i18n.newsletterOptinEmailPlaceholder }}">

                                                        <label class="caw-newsletter-consent">
                                                            <input type="checkbox"
                                                                   x-model="message.card.data.consent"
                                                                   x-bind:disabled="message.card.data.submitting">
                                                            <span>
                                                                {{ i18n.newsletterOptinConsentLabel }}
                                                                {% if privacyPolicyUrl %}
                                                                    <a href="{{ privacyPolicyUrl }}" target="_blank" rel="noopener">{{ i18n.newsletterOptinPrivacyLink }}</a>
                                                                {% endif %}
                                                            </span>
                                                        </label>

                                                        <button type="submit" class="caw-btn caw-btn-primary caw-btn-block"
                                                                x-bind:disabled="message.card.data.submitting || !message.card.data.email || !message.card.data.consent"
                                                                x-text="message.card.data.submitting ? i18n.newsletterOptinSubscribing : i18n.newsletterOptinSubscribe"></button>
                                                    </div>
                                                </template>

                                                <p class="caw-newsletter-success" x-show="message.card.data.subscribed" x-text="i18n.newsletterOptinSubscribed" role="status"></p>

                                                <p class="caw-coupon-error" x-show="message.card.data.error" x-text="message.card.data.error" role="alert"></p>
                                            </form>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </template>

                        <p class="caw-typing" x-show="pending" aria-live="polite">
                            <span></span><span></span><span></span>
                        </p>
                    </div>

                    <form class="caw-composer" x-on:submit.prevent="send()">
                        <div class="caw-glow caw-glow-composer">
                            <div class="caw-composer-inner">
                                <input type="text"
                                       x-ref="composerInput"
                                       x-model="input"
                                       maxlength="2000"
                                       autocomplete="off"
                                       aria-label="{{ i18n.askPlaceholder }}"
                                       placeholder="{{ i18n.askPlaceholder }}"
                                       x-bind:disabled="pending">
                                <button type="submit" x-bind:disabled="pending || !input.trim()" aria-label="{{ i18n.send }}">➤</button>
                            </div>
                        </div>
                    </form>

                    <div class="caw-spacer caw-spacer-bottom"></div>
                </div>

                <aside class="caw-aside">
                    <section class="caw-card caw-card-account" aria-label="{{ i18n.accountTitle }}">
                        <h3 class="caw-card-title">{{ i18n.accountTitle }}</h3>

                        <template x-if="account.loggedIn">
                            <div class="caw-account-connected">
                                <a class="caw-btn caw-btn-primary caw-btn-block" x-bind:href="account.accountUrl" x-text="i18n.myAccount"></a>

                                <p class="caw-card-empty" x-show="account.orders.length === 0" x-text="i18n.noOrdersYet"></p>

                                <ul class="caw-order-list" x-show="account.orders.length > 0">
                                    <template x-for="order in account.orders" x-bind:key="order.ref">
                                        <li class="caw-order-line">
                                            <a class="caw-order-link" x-bind:href="order.url">
                                                <span class="caw-order-ref" x-text="order.ref"></span>
                                                <span class="caw-order-status" x-bind:class="'caw-order-status--' + order.statusCode" x-text="order.status"></span>
                                            </a>
                                            <span class="caw-order-meta">
                                                <span x-text="order.date"></span>
                                                <span x-text="money(order.totalAmount, order.currency)"></span>
                                            </span>
                                        </li>
                                    </template>
                                </ul>

                                <a class="caw-link" x-show="account.orders.length > 0" x-bind:href="account.ordersUrl" x-text="i18n.viewAllOrders"></a>
                            </div>
                        </template>

                        <template x-if="!account.loggedIn">
                            <div class="caw-account-anonymous">
                                <div class="caw-account-actions">
                                    <a class="caw-btn caw-btn-ghost caw-btn-compact" x-bind:href="account.registerUrl" x-text="i18n.createAccount"></a>
                                    <a class="caw-btn caw-btn-ghost caw-btn-compact" x-bind:href="account.loginUrl" x-text="i18n.login"></a>
                                </div>
                            </div>
                        </template>
                    </section>

                    <section class="caw-card">
                        <h3 class="caw-card-title">
                            {{ i18n.yourCart }}
                            <span class="caw-pill" x-show="cart.itemCount > 0" x-text="cart.itemCount"></span>
                        </h3>
                        <p class="caw-card-empty" x-show="cart.itemCount === 0">{{ i18n.cartEmpty }}</p>
                        <template x-for="item in cart.items.slice(0, 3)" x-bind:key="item.productId">
                            <p class="caw-cart-line">
                                <span class="caw-cart-thumb">
                                    <img x-show="item.imageUrl" x-bind:src="item.imageUrl" x-bind:alt="item.title" loading="lazy">
                                </span>
                                <span class="caw-cart-name" x-text="item.title"></span>
                                <span class="caw-cart-qty" x-text="'×' + item.quantity"></span>
                                <span class="caw-cart-price" x-text="money(item.totalTaxedPrice, cart.currency)"></span>
                            </p>
                        </template>
                        <p class="caw-card-more" x-show="cart.items.length > 3"
                           x-text="'+ ' + (cart.items.length - 3) + ' ' + i18n.otherLines"></p>
                        <p class="caw-cart-total" x-show="cart.itemCount > 0">
                            <span>{{ i18n.total }}</span>
                            <strong x-text="money(cart.totalTaxedAmount, cart.currency)"></strong>
                        </p>
                        <a class="caw-btn caw-btn-primary caw-btn-block" href="{{ checkoutUrl }}" x-show="cart.itemCount > 0">{{ i18n.completeOrder }}</a>
                    </section>

                    <section class="caw-card" x-show="highlights.length > 0">
                        <h3 class="caw-card-title">{{ i18n.highlightsTitle }}</h3>
                        <template x-for="product in highlights" x-bind:key="product.id">
                            <a class="caw-mini-product" x-bind:href="product.url">
                                <span class="caw-cart-thumb">
                                    <img x-show="product.imageUrl" x-bind:src="product.imageUrl" x-bind:alt="product.title" loading="lazy">
                                </span>
                                <span class="caw-mini-body">
                                    <span class="caw-mini-title" x-text="product.title"></span>
                                    <span class="caw-mini-price" x-text="money(bestPrice(product), product.currency)"></span>
                                </span>
                            </a>
                        </template>
                    </section>

                    <section class="caw-card" x-show="messages.length > 0">
                        <h3 class="caw-card-title">{{ i18n.suggestionsTitle }}</h3>
                        <div class="caw-chips">
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestProduct }}</button>
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestCart }}</button>
                            <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestShipping }}</button>
                            {% if isCustomerLoggedIn %}
                                <button type="button" class="caw-chip" x-on:click="sendSuggestion($el.textContent)">{{ i18n.suggestOrders }}</button>
                            {% endif %}
                        </div>
                    </section>
                </aside>

            </div>
        </div>
    </section>
</div>
