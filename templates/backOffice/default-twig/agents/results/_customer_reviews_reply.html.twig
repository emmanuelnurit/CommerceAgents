{% if proposals|length > 0 %}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0">{{ 'Proposals to validate'|trans({}, 'commerceagents') }}</h2>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('commerceagents_changes', {agentId: agentId}) }}">
            <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>{{ 'Open the proposals console'|trans({}, 'commerceagents') }}
        </a>
    </div>

    {% if totalCount > maxProposals %}
        <p class="small text-muted" data-testid="agent-results-reviews-capped">
            {{ 'Showing the %shown% most recent proposals out of %total%.'|trans({'%shown%': maxProposals, '%total%': totalCount}, 'commerceagents') }}
        </p>
    {% endif %}

    <div class="list-group" data-testid="agent-results-customer-reviews-reply">
        {% for proposal in proposals %}
            <div class="list-group-item" data-testid="agent-results-proposal-{{ proposal.id }}">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <span class="small text-muted">{{ proposal.createdAt ? proposal.createdAt|relative_time : '—' }}</span>
                    {% if proposal.status == 'pending' %}
                        <span class="badge text-bg-warning">{{ 'Pending'|trans({}, 'commerceagents') }}</span>
                    {% elseif proposal.status == 'applied' %}
                        <span class="badge text-bg-success">{{ 'Applied'|trans({}, 'commerceagents') }}</span>
                    {% elseif proposal.status == 'rejected' %}
                        <span class="badge text-bg-secondary">{{ 'Rejected'|trans({}, 'commerceagents') }}</span>
                    {% else %}
                        <span class="badge text-bg-danger">{{ 'Failed'|trans({}, 'commerceagents') }}</span>
                    {% endif %}
                </div>

                {% if proposal.review %}
                    <div class="mb-1">
                        <strong>{{ proposal.review.productTitle ?? 'Review #%id%'|trans({'%id%': proposal.targetId}, 'commerceagents') }}</strong>
                        <span class="text-muted small">{{ 'By %author%'|trans({'%author%': proposal.review.author}, 'commerceagents') }}</span>
                    </div>
                    <div class="mb-1" aria-label="{{ 'Rating: %rating%/5'|trans({'%rating%': proposal.review.rating|default('?')}, 'commerceagents') }}">
                        {% for i in 1..5 %}<i class="bi {{ i <= proposal.review.rating|default(0) ? 'bi-star-fill text-warning' : 'bi-star text-muted' }}" aria-hidden="true"></i>{% endfor %}
                    </div>
                    <p class="small fst-italic mb-2">
                        {{ proposal.review.content|default('')|slice(0, 200) }}{{ proposal.review.content|default('')|length > 200 ? '…' : '' }}
                    </p>
                {% else %}
                    <p class="text-muted fst-italic mb-2">
                        {{ 'Review #%id% (deleted)'|trans({'%id%': proposal.targetId}, 'commerceagents') }}
                    </p>
                {% endif %}

                <div class="p-2 bg-light rounded">
                    <div class="form-text mb-1">{{ 'Proposed reply'|trans({}, 'commerceagents') }}</div>
                    <p class="mb-0">{{ proposal.reply ?? '' }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% elseif hasEverRun %}
    <div class="alert alert-light border mb-0" data-testid="agent-results-customer-reviews-reply-empty-ran">
        <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
        {{ 'This agent has already run but found nothing to propose.'|trans({}, 'commerceagents') }}
        <div class="mt-2">
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('commerceagents_agents_runs', {agentId: agentId}) }}">
                <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>{{ 'Open run history'|trans({}, 'commerceagents') }}
            </a>
        </div>
    </div>
{% else %}
    <div class="alert alert-light border mb-0" data-testid="agent-results-customer-reviews-reply-empty">
        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
        {{ 'No proposal for this agent yet.'|trans({}, 'commerceagents') }}
    </div>
{% endif %}
