<script>
(function () {
    const root = document.getElementById('ca-config');
    if (!root) {
        return;
    }
    const settingsForm = document.getElementById('ca-settings-form');
    const token = settingsForm.querySelector('input[name="_token"]');
    const tabInput = document.getElementById('ca-settings-tab');

    // --- Model pickers (hero + wherever else on the page) ---
    if (window.CommerceAgentsModelPicker) {
        window.CommerceAgentsModelPicker.init(root);
    }

    // --- Gear panel ("Paramètres généraux", spec §3.2) ---
    const panel = document.getElementById('ca-settings-panel');
    const gearButton = document.getElementById('ca-gear-btn');
    const gearClose = document.getElementById('ca-gear-close');
    function togglePanel(show) {
        panel.classList.toggle('d-none', !show);
        gearButton.setAttribute('aria-expanded', show ? 'true' : 'false');
        if (show) {
            panel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        }
    }
    gearButton.addEventListener('click', function () {
        togglePanel(panel.classList.contains('d-none'));
    });
    if (gearClose) {
        gearClose.addEventListener('click', function () {
            togglePanel(false);
            gearButton.focus();
        });
    }

    // --- Sections nav-pills inside the gear panel ---
    const tabButtons = root.querySelectorAll('[data-ca-tab]');
    const panes = root.querySelectorAll('[data-ca-pane]');
    function activateTab(name) {
        let found = false;
        panes.forEach(function (pane) {
            const match = pane.dataset.caPane === name;
            pane.classList.toggle('d-none', !match);
            found = found || match;
        });
        if (!found) {
            return activateTab('providers');
        }
        tabButtons.forEach(function (button) {
            const match = button.dataset.caTab === name;
            button.classList.toggle('active', match);
            button.setAttribute('aria-selected', match ? 'true' : 'false');
        });
        tabInput.value = name;
    }
    tabButtons.forEach(function (button) {
        button.addEventListener('click', function (event) {
            event.preventDefault();
            activateTab(button.dataset.caTab);
        });
    });
    // Links outside the panel (alerts, "Details") open it on the right section.
    root.querySelectorAll('[data-open-settings]').forEach(function (link) {
        link.addEventListener('click', function (event) {
            event.preventDefault();
            togglePanel(true);
            activateTab(link.dataset.openSettings);
        });
    });
    activateTab('providers');

    // --- Active provider highlight ---
    const activeSelect = document.getElementById('ca-provider');
    function highlightActive() {
        root.querySelectorAll('.ca-provider-panel').forEach(function (panel) {
            panel.classList.toggle('border-primary', panel.dataset.provider === activeSelect.value);
        });
    }
    activeSelect.addEventListener('change', highlightActive);
    highlightActive();

    // --- Price hint under each model field ---
    root.querySelectorAll('.ca-model-input').forEach(function (input) {
        const hint = input.parentElement.querySelector('.ca-model-hint');
        const list = document.getElementById(input.getAttribute('list'));
        const initial = hint.textContent;
        function update() {
            const option = list ? list.querySelector('option[value="' + CSS.escape(input.value.trim()) + '"]') : null;
            if (!option) {
                hint.textContent = input.value.trim() === '' ? initial : hint.dataset.unpriced;
                return;
            }
            const priceIn = option.dataset.priceInput;
            const priceOut = option.dataset.priceOutput;
            hint.textContent = (priceIn !== '' && priceOut !== '')
                ? '$' + priceIn + ' / $' + priceOut + ' ' + hint.dataset.per
                : hint.dataset.unpriced;
        }
        input.addEventListener('input', update);
        input.addEventListener('change', update);
        update();
    });

    // --- Disabled models toggle ---
    root.querySelectorAll('.ca-show-disabled').forEach(function (toggle) {
        toggle.addEventListener('change', function () {
            root.querySelectorAll('table[data-provider="' + toggle.dataset.provider + '"] tr.ca-disabled-row').forEach(function (row) {
                row.classList.toggle('d-none', !toggle.checked);
            });
        });
    });

    // --- Provider actions (other providers panel) ---
    async function post(url, provider) {
        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ _token: token ? token.value : '', provider: provider }),
        });

        return response.json().catch(() => ({ success: false, message: 'HTTP ' + response.status }));
    }

    function bind(selector, urlAttribute, onSuccess) {
        root.querySelectorAll(selector).forEach(function (button) {
            button.addEventListener('click', async function () {
                const panel = button.closest('.ca-provider-panel');
                const status = panel ? panel.querySelector('.ca-provider-status') : null;
                button.disabled = true;
                if (status) {
                    status.className = 'ca-provider-status small text-muted';
                    status.textContent = '…';
                }

                try {
                    const payload = await post(button.dataset[urlAttribute], button.dataset.provider);
                    if (status) {
                        status.className = 'ca-provider-status small ' + (payload.success ? 'text-success' : 'text-danger');
                        status.textContent = payload.message || (payload.success ? 'OK' : 'Error');
                    }
                    if (payload.success && onSuccess) {
                        onSuccess(payload);
                    }
                } catch (error) {
                    if (status) {
                        status.className = 'ca-provider-status small text-danger';
                        status.textContent = 'Request failed';
                    }
                } finally {
                    button.disabled = false;
                }
            });
        });
    }

    bind('.ca-test-connection', 'testUrl', null);
    bind('.ca-refresh-models', 'refreshUrl', function (payload) {
        if (payload.added > 0) {
            togglePanel(true);
            activateTab('models');
            window.location.reload();
        }
    });

    // --- Hero: show/hide the API key ---
    const heroKeyInput = document.getElementById('ca-hero-key');
    const heroKeyEye = document.getElementById('ca-hero-key-eye');
    if (heroKeyInput && heroKeyEye) {
        heroKeyEye.addEventListener('click', function () {
            const show = heroKeyInput.type === 'password';
            heroKeyInput.type = show ? 'text' : 'password';
            heroKeyEye.setAttribute('aria-label', show ? heroKeyEye.dataset.hideLabel || 'Hide the key' : heroKeyEye.dataset.showLabel || 'Show the key');
            heroKeyEye.firstElementChild.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    }

    // --- Hero: test connection (Mistral), feeds the status badge (spec §3.4) ---
    const heroTestButton = document.getElementById('ca-hero-test');
    const heroTestStatus = document.getElementById('ca-hero-test-status');
    const heroBadge = document.querySelector('[data-testid="ca-hero-status"]');
    if (heroTestButton) {
        heroTestButton.addEventListener('click', async function () {
            heroTestButton.disabled = true;
            heroTestStatus.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>' + (heroTestStatus.dataset.checking || '…');
            try {
                const payload = await post(heroTestButton.dataset.testUrl, 'mistral');
                heroTestStatus.textContent = payload.message || '';
                if (payload.success) {
                    heroBadge.className = 'badge text-bg-success';
                    heroBadge.textContent = heroBadge.dataset.connectedLabel || heroBadge.textContent;
                } else {
                    heroBadge.className = 'badge text-bg-danger';
                    heroBadge.textContent = heroBadge.dataset.invalidLabel || heroBadge.textContent;
                }
            } catch (error) {
                heroTestStatus.textContent = 'Request failed';
            } finally {
                heroTestButton.disabled = false;
            }
        });
    }

    // --- Channel connectors ("Canaux" tab, MYO-300) ---
    root.querySelectorAll('.ca-channel-form').forEach(function (form) {
        const status = form.querySelector('.ca-channel-status');
        const badge = form.querySelector('.ca-channel-configured-badge');

        function setStatus(success, message) {
            status.className = 'ca-channel-status small ' + (success ? 'text-success' : 'text-danger');
            status.textContent = message || '';
        }

        async function callChannelEndpoint(url) {
            const response = await fetch(url, { method: 'POST', body: new FormData(form) });

            return response.json().catch(function () {
                return { success: false, message: 'HTTP ' + response.status };
            });
        }

        form.querySelector('.ca-channel-test').addEventListener('click', async function () {
            const button = this;
            button.disabled = true;
            setStatus(true, '…');
            try {
                const payload = await callChannelEndpoint(form.dataset.testUrl);
                setStatus(payload.success, payload.message);
            } catch (error) {
                setStatus(false, 'Request failed');
            } finally {
                button.disabled = false;
            }
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const saveButton = form.querySelector('.ca-channel-save');
            saveButton.disabled = true;
            setStatus(true, '…');
            try {
                const payload = await callChannelEndpoint(form.dataset.saveUrl);
                setStatus(payload.success, payload.message);
                if (payload.success) {
                    if (badge) {
                        badge.className = 'badge text-bg-success ca-channel-configured-badge';
                        badge.textContent = badge.dataset.configuredLabel || badge.textContent;
                    }
                    form.querySelectorAll('input[data-secret="1"]').forEach(function (input) {
                        input.value = '';
                        input.placeholder = input.dataset.configuredPlaceholder || input.placeholder;
                    });
                }
            } catch (error) {
                setStatus(false, 'Request failed');
            } finally {
                saveButton.disabled = false;
            }
        });
    });
})();
</script>
