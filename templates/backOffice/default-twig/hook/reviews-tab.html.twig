<div class="row" data-testid="commerceagents-reviews-tab">
    <div class="col-md-12">
        {% if reviews is empty %}
            <p class="text-muted">{{ 'No review yet for this product.'|trans({}, 'commerceagents') }}</p>
        {% endif %}

        {% for review in reviews %}
            <div class="card mb-3" data-testid="commerceagents-review-{{ review.id }}">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>{{ review.author.name|default('Anonymous'|trans({}, 'commerceagents')) }}</strong>
                            {% if review.rating %}
                                <span class="text-muted ms-2">{{ review.rating }}/5</span>
                            {% endif %}
                        </div>
                        <span class="badge text-bg-{{ review.status.css }}-subtle text-{{ review.status.css }}-emphasis">{{ review.status.label }}</span>
                    </div>

                    {% if review.title %}
                        <h6 class="mt-2 mb-1">{{ review.title }}</h6>
                    {% endif %}

                    <p class="mb-1">{{ review.content }}</p>
                    <div class="text-muted small">{{ review.createdAt ? review.createdAt|date('d/m/Y H:i') : '' }}</div>

                    {% if replies[review.id] is defined %}
                        {% set reply = replies[review.id] %}
                        <div class="mt-3 ps-3 border-start border-3 border-success-subtle" data-testid="commerceagents-review-reply-{{ review.id }}">
                            <div class="fw-semibold">{{ 'Merchant reply'|trans({}, 'commerceagents') }}</div>
                            <p class="mb-1">{{ reply.content }}</p>
                            <div class="text-muted small">
                                {{ 'By %agent%, approved on %date%'|trans({
                                    '%agent%': reply.agentName ?? ('CommerceAgents'|trans({}, 'commerceagents')),
                                    '%date%': reply.approvedAt ? reply.approvedAt|date('d/m/Y H:i') : '',
                                }, 'commerceagents') }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
