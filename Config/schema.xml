<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../vendor/thelia/propel/resources/xsd/database.xsd">

    <table name="agent_conversation" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="type" required="true" size="20" type="VARCHAR"/>
        <column name="customer_id" type="INTEGER"/>
        <column name="admin_id" type="INTEGER"/>
        <column name="session_ref" size="255" type="VARCHAR"/>
        <column defaultValue="fr_FR" name="locale" size="10" type="VARCHAR"/>
        <column defaultValue="0" name="proactive_prompt_count" required="true" type="INTEGER"/>
        <column name="proactive_last_prompted_at" type="TIMESTAMP"/>
        <column defaultValue="0" name="proactive_dismissed" required="true" type="TINYINT"/>
        <column name="proactive_scenarios" type="CLOB"/>
        <index name="idx_agent_conversation_session_ref">
            <index-column name="session_ref"/>
        </index>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_message" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="conversation_id" required="true" type="INTEGER"/>
        <column name="role" required="true" size="20" type="VARCHAR"/>
        <column name="content" type="CLOB"/>
        <column name="tool_calls" type="CLOB"/>
        <column name="tokens_in" type="INTEGER"/>
        <column name="tokens_out" type="INTEGER"/>
        <column name="model" size="120" type="VARCHAR"/>
        <column name="cost" scale="8" size="14" type="DECIMAL"/>
        <foreign-key foreignTable="agent_conversation" name="fk_agent_message_conversation" onDelete="CASCADE">
            <reference foreign="id" local="conversation_id"/>
        </foreign-key>
        <behavior name="timestampable">
            <parameter name="disable_updated_at" value="true"/>
        </behavior>
    </table>

    <table name="agent_staged_change" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="conversation_id" required="true" type="INTEGER"/>
        <column name="agent_definition_id" type="INTEGER"/>
        <column name="admin_id" required="true" type="INTEGER"/>
        <column name="target_type" required="true" size="20" type="VARCHAR"/>
        <column name="target_id" required="true" type="INTEGER"/>
        <column name="payload_before" type="CLOB"/>
        <column name="payload_after" type="CLOB"/>
        <column defaultValue="pending" name="status" required="true" size="20" type="VARCHAR"/>
        <column name="approved_by" type="INTEGER"/>
        <column name="approved_at" type="TIMESTAMP"/>
        <column name="applied_at" type="TIMESTAMP"/>
        <column name="error" type="CLOB"/>
        <index name="idx_agent_staged_change_status">
            <index-column name="status"/>
        </index>
        <index name="idx_agent_staged_change_definition">
            <index-column name="agent_definition_id"/>
        </index>
        <foreign-key foreignTable="agent_conversation" name="fk_agent_staged_change_conversation" onDelete="CASCADE">
            <reference foreign="id" local="conversation_id"/>
        </foreign-key>
        <foreign-key foreignTable="agent_definition" name="fk_agent_staged_change_definition" onDelete="SETNULL">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_definition" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="code" required="true" size="80" type="VARCHAR"/>
        <column name="title" required="true" size="255" type="VARCHAR"/>
        <column name="description" type="CLOB"/>
        <column defaultValue="0" name="enabled" required="true" type="TINYINT"/>
        <column name="role_prompt" type="CLOB"/>
        <column name="provider" size="40" type="VARCHAR"/>
        <column name="model" size="120" type="VARCHAR"/>
        <column defaultValue="fr_FR" name="locale" size="10" type="VARCHAR"/>
        <column defaultValue="5" name="max_iterations" required="true" type="INTEGER"/>
        <column name="monthly_budget_usd" scale="4" size="12" type="DECIMAL"/>
        <column defaultValue="0" name="auto_apply" required="true" type="TINYINT"/>
        <column defaultValue="0" name="consecutive_failures" required="true" type="INTEGER"/>
        <column name="preset_code" size="60" type="VARCHAR"/>
        <unique name="uq_agent_definition_code">
            <unique-column name="code"/>
        </unique>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_memory" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="agent_definition_id" required="true" type="INTEGER"/>
        <column name="content" required="true" type="CLOB"/>
        <column defaultValue="manual" name="source" required="true" size="20" type="VARCHAR"/>
        <column defaultValue="1" name="enabled" required="true" type="TINYINT"/>
        <index name="idx_agent_memory_definition">
            <index-column name="agent_definition_id"/>
        </index>
        <foreign-key foreignTable="agent_definition" name="fk_agent_memory_definition" onDelete="CASCADE">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_capability" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="agent_definition_id" required="true" type="INTEGER"/>
        <column name="capability" required="true" size="60" type="VARCHAR"/>
        <unique name="uq_agent_capability_definition_capability">
            <unique-column name="agent_definition_id"/>
            <unique-column name="capability"/>
        </unique>
        <foreign-key foreignTable="agent_definition" name="fk_agent_capability_definition" onDelete="CASCADE">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
    </table>

    <table name="agent_trigger" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="agent_definition_id" required="true" type="INTEGER"/>
        <column name="type" required="true" size="20" type="VARCHAR"/>
        <column name="event_name" size="255" type="VARCHAR"/>
        <column name="cron_expression" size="120" type="VARCHAR"/>
        <column name="conditions" type="CLOB"/>
        <column defaultValue="1" name="enabled" required="true" type="TINYINT"/>
        <column name="last_run_at" type="TIMESTAMP"/>
        <column name="next_run_at" type="TIMESTAMP"/>
        <foreign-key foreignTable="agent_definition" name="fk_agent_trigger_definition" onDelete="CASCADE">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_channel" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="agent_definition_id" required="true" type="INTEGER"/>
        <column name="connector_code" required="true" size="40" type="VARCHAR"/>
        <column name="settings" type="CLOB"/>
        <column defaultValue="draft" name="mode" required="true" size="10" type="VARCHAR"/>
        <column defaultValue="1" name="enabled" required="true" type="TINYINT"/>
        <foreign-key foreignTable="agent_definition" name="fk_agent_channel_definition" onDelete="CASCADE">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_run" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="agent_definition_id" required="true" type="INTEGER"/>
        <column name="agent_trigger_id" type="INTEGER"/>
        <column name="conversation_id" type="INTEGER"/>
        <column defaultValue="queued" name="status" required="true" size="20" type="VARCHAR"/>
        <column name="dedup_key" size="191" type="VARCHAR"/>
        <column name="context" type="CLOB"/>
        <column name="summary" type="CLOB"/>
        <column name="error" type="CLOB"/>
        <column name="started_at" type="TIMESTAMP"/>
        <column name="finished_at" type="TIMESTAMP"/>
        <unique name="uq_agent_run_definition_dedup">
            <unique-column name="agent_definition_id"/>
            <unique-column name="dedup_key"/>
        </unique>
        <index name="idx_agent_run_status">
            <index-column name="status"/>
        </index>
        <foreign-key foreignTable="agent_definition" name="fk_agent_run_definition" onDelete="CASCADE">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <foreign-key foreignTable="agent_trigger" name="fk_agent_run_trigger" onDelete="SETNULL">
            <reference foreign="id" local="agent_trigger_id"/>
        </foreign-key>
        <foreign-key foreignTable="agent_conversation" name="fk_agent_run_conversation" onDelete="SETNULL">
            <reference foreign="id" local="conversation_id"/>
        </foreign-key>
        <behavior name="timestampable"/>
    </table>

    <table name="agent_action_log" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="tool_name" required="true" size="120" type="VARCHAR"/>
        <column name="capability" size="60" type="VARCHAR"/>
        <column defaultValue="chat" name="channel" required="true" size="20" type="VARCHAR"/>
        <column name="status" required="true" size="20" type="VARCHAR"/>
        <column name="conversation_id" type="INTEGER"/>
        <column name="agent_definition_id" type="INTEGER"/>
        <column name="admin_id" type="INTEGER"/>
        <column name="customer_id" type="INTEGER"/>
        <column name="arguments" type="CLOB"/>
        <column name="error" type="CLOB"/>
        <index name="idx_agent_action_log_tool_name">
            <index-column name="tool_name"/>
        </index>
        <index name="idx_agent_action_log_definition">
            <index-column name="agent_definition_id"/>
        </index>
        <foreign-key foreignTable="agent_conversation" name="fk_agent_action_log_conversation" onDelete="SETNULL">
            <reference foreign="id" local="conversation_id"/>
        </foreign-key>
        <foreign-key foreignTable="agent_definition" name="fk_agent_action_log_definition" onDelete="SETNULL">
            <reference foreign="id" local="agent_definition_id"/>
        </foreign-key>
        <behavior name="timestampable">
            <parameter name="disable_updated_at" value="true"/>
        </behavior>
    </table>

    <table name="agent_model" namespace="CommerceAgents\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER"/>
        <column name="provider" required="true" size="40" type="VARCHAR"/>
        <column name="model_id" required="true" size="120" type="VARCHAR"/>
        <column name="name" size="150" type="VARCHAR"/>
        <column name="price_input" scale="6" size="12" type="DECIMAL"/>
        <column name="price_output" scale="6" size="12" type="DECIMAL"/>
        <column name="context_window" type="INTEGER"/>
        <column name="tier" size="20" type="VARCHAR"/>
        <column name="currency" size="3" type="VARCHAR"/>
        <column defaultValue="1" name="enabled" required="true" type="TINYINT"/>
        <column defaultValue="catalog" name="source" required="true" size="20" type="VARCHAR"/>
        <column name="priced_at" type="DATE"/>
        <column name="last_seen_at" type="TIMESTAMP"/>
        <unique name="uq_agent_model_provider_model">
            <unique-column name="provider"/>
            <unique-column name="model_id"/>
        </unique>
        <behavior name="timestampable"/>
    </table>

</database>
